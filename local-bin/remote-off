#!/usr/bin/env bash
# remote-off — turn off all remote access and keep it off (survives reboots).
# Undo with remote-on. --dry-run prints the steps without running them.
set -u
DRY=0; [ "${1:-}" = "--dry-run" ] && DRY=1
run() { echo "+ $*"; [ $DRY = 1 ] || "$@"; }

if [ -n "${SSH_CONNECTION:-}" ] && [ $DRY = 0 ]; then
  read -rp "You're connected over SSH; this will cut your connection. Continue? [y/N] " a
  [ "$a" = y ] || [ "$a" = Y ] || exit 1
fi
[ $DRY = 1 ] || sudo -v || exit 1        # ask for the password now, before anything changes

run touch "$HOME/.config/remote-off"      # Hyprland skips Sunshine while this exists
run systemctl --user disable --now code-server moonlight-web dashboard-api taildrop-receive
run tailscale serve reset                 # dashboard, VS Code, Desktop and any public demo
run pkill -x sunshine
echo "Remote access is off. Disconnecting Tailscale (remote-on brings it all back)."
run tailscale down
run sudo systemctl disable --now tailscaled
