#!/usr/bin/env bash
# ASU VPN (Cisco Secure Client) from any terminal, SSH included.
#   asu-vpn on        open Cisco Secure Client on the laptop's screen
#   asu-vpn off       disconnect
#   asu-vpn [status]  Connected / Disconnected
# ASU signs in through a web page (SSO + Duo) that only works in Cisco's own window:
# the CLI and openconnect can't do it. So `on` opens the app on the desktop, and you
# finish in Desktop (Moonlight Web) from wherever you are.
VPN=/opt/cisco/secureclient/bin/vpn

case "${1:-status}" in
  on)
    sig=$(ls -t "/run/user/$UID/hypr/" 2>/dev/null | head -1)
    [ -n "$sig" ] || { echo "Hyprland isn't running; log in on the laptop first." >&2; exit 1; }
    systemctl --user start moonlight-web
    HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl dispatch exec /opt/cisco/secureclient/bin/vpnui >/dev/null
    host=$(tailscale status --json 2>/dev/null | jq -r '.Self.DNSName | rtrimstr(".")')
    echo "Cisco Secure Client is open on the laptop. In Desktop (https://$host:10000):"
    echo "click Connect, sign in, approve Duo. Then check with: asu-vpn" ;;
  off)    "$VPN" disconnect | grep '>> ' ;;
  status) "$VPN" state | grep '>> state:' | tail -1 | sed 's/.*state: //' ;;
  *)      echo "usage: asu-vpn [on|off|status]" >&2; exit 2 ;;
esac
