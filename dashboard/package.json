{
  "name": "ash-fedora-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Tailnet dashboard for a Fedora + Hyprland workstation: services, live metrics, sessions and docs.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "deploy": "next build && rsync -a --delete out/ \"$HOME/.local/share/dashboard/\""
  },
  "dependencies": {
    "geist": "^1.7.2",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
