[Unit]
Description=Proxy localhost-only servers to the tailnet with Caddy (https://<host>.ts.net:PORT)
After=network-online.target

[Service]
# Background priority: yield CPU/disk to the desktop; soft memory cap
Nice=10
CPUWeight=20
IOWeight=20
MemoryHigh=64M
ExecStart=%h/.local/bin/tailnet-ports
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
