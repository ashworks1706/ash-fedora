[Unit]
Description=ntfy push notification server (tailnet only)
After=network-online.target

[Service]
EnvironmentFile=%h/.config/ntfy/env
ExecStart=%h/.local/share/ntfy/bin/ntfy serve --config %h/.config/ntfy/server.yml
Restart=on-failure
RestartSec=5
# Background priority: yield CPU/disk to the desktop; soft memory cap
Nice=10
CPUWeight=20
IOWeight=20
MemoryHigh=100M

[Install]
WantedBy=default.target
