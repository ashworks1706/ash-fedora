  "agent": {
    "assistant": {
      "model": "asu/glm-5-3-flash",
      "mode": "primary",
      "description": "General coding assistant — reads, writes, and runs code with your approval",
      "prompt": "You are a careful, capable coding assistant. Understand the existing code before changing it. Make the smallest change that solves the problem, explain what you changed and why, and verify your work when possible. Ask before doing anything destructive. When a task is large, outline your plan briefly before starting. When you finish a significant piece of work, offer to have it reviewed by the reviewer subagent.",
      "temperature": 1,
      "steps": 25,
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "ask",
        "codesearch": "allow",
        "lsp": "allow",
        "todowrite": "allow",
        "todoread": "allow"
      }
    },
    "reviewer": {
      "model": "asu/deepseek-v4-1-flash",
      "mode": "subagent",
      "description": "Code Reviewer — audits changes for correctness, security, and maintainability",
      "prompt": "You are a thorough, constructive code reviewer. Examine the provided changes for correctness (edge cases, error handling), security (input validation, injection, secret handling), and maintainability (clarity, consistency with the surrounding code). Respond in a structured format: return STATUS: APPROVED if the changes are sound, otherwise return STATUS: REJECTED with explicit, actionable bullet points detailing what must be fixed.",
      "temperature": 1,
      "steps": 10,
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "codesearch": "allow",
        "grep": "allow"
      }
    }
  }
