# Only reachable through Tailscale (tailscale serve proxies HTTPS :8444 -> here).
# install.sh writes ~/.config/code-server/config.yaml with a fresh random password.
bind-addr: 127.0.0.1:8080
auth: password
password: __GENERATED__
cert: false
# Keep a disconnected window (Mac asleep, Wi-Fi drop) resumable for 7 days, not 3 hours:
reconnection-grace-time: 604800
